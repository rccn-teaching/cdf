# Git LFS tracking rules for 3D models, images, and binaries

# Rhino 3D Models & Backups
*.3dm filter=lfs diff=lfs merge=lfs -text
*.3dmbak filter=lfs diff=lfs merge=lfs -text

# Grasshopper Binary Definitions
*.gh filter=lfs diff=lfs merge=lfs -text

# Image Formats
